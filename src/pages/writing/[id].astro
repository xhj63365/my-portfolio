---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={`${post.data.title} - 文字与光影`}>
  <article class="prose prose-stone max-w-none dark:prose-invert">
    <header class="mb-10 not-prose">
      <a
        href="/writing"
        class="mb-4 inline-block text-sm text-blue-600 hover:text-blue-700"
      >
        ← 返回写作列表
      </a>
      <h1 class="font-serif text-4xl font-bold">{post.data.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-stone-500">
        <time>{fmt(post.data.date)}</time>
        {post.data.tags.length > 0 && (
          <div class="flex gap-2">
            {post.data.tags.map((t) => (
              <span
                class="rounded-full bg-stone-100 px-3 py-0.5 text-xs text-stone-600 dark:bg-stone-800 dark:text-stone-400"
              >
                #{t}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>
    <Content />
  </article>
</Layout>
