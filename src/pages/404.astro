---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面不存在 - 文字与光影">
  <div class="flex flex-col items-center py-24 text-center">
    <p class="font-serif text-6xl font-bold text-blue-600">404</p>
    <h1 class="mt-4 text-2xl font-bold">这个页面走丢了</h1>
    <p class="mt-2 text-stone-600 dark:text-stone-400">
      你访问的地址不存在，也许它被移动或删除了。
    </p>
    <a
      href="/"
      class="mt-8 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-blue-700"
    >
      ← 返回首页
    </a>
  </div>
</Layout>
