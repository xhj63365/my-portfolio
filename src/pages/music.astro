---
import Layout from '../layouts/Layout.astro';

// 在这里添加你的歌曲列表
// 格式：{ name: '显示名称', src: '/音频文件路径' }
const songs = [
  { name: 'Jazz BGM', src: '/Jazzbgm.mp3' },
  // 添加更多歌曲：
  // { name: '歌曲名称', src: '/music/song.mp3' },
];
---

<Layout title="音乐 - 文字与光影" description="Joexu 的音乐分享">
  <h1 class="mb-2 font-serif text-4xl font-bold">音乐</h1>
  <p class="mb-12 text-stone-600 dark:text-stone-400">
    一些喜欢的旋律，陪我度过写字和发呆的时光。
  </p>

  {/* macOS 风格播放器窗口 */}
  <div class="mx-auto max-w-lg overflow-hidden rounded-xl border border-stone-200/60 bg-white shadow-md dark:border-stone-700/60 dark:bg-stone-900">
    {/* macOS 标题栏 */}
    <div class="flex items-center gap-2 border-b border-stone-200/60 bg-stone-50/50 px-4 py-2.5 dark:border-stone-700/60 dark:bg-stone-800/50">
      <div class="flex items-center gap-1.5">
        <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
        <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
        <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
      </div>
      <span id="window-title" class="flex-1 text-center text-xs text-stone-400 dark:text-stone-500 truncate">音乐播放器</span>
      <div class="w-[52px]"></div>
    </div>

    {/* 播放器内容 */}
    <div class="p-6">
      {/* 碟片 */}
      <div class="mb-6 flex justify-center">
        <div id="disc" class="flex h-32 w-32 items-center justify-center rounded-full bg-gradient-to-br from-stone-100 to-stone-300 shadow-inner dark:from-stone-700 dark:to-stone-800">
          <svg class="h-14 w-14 text-stone-400 dark:text-stone-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <circle cx="12" cy="12" r="10"></circle>
          </svg>
        </div>
      </div>

      {/* 歌曲名 */}
      <div class="mb-5 text-center">
        <p id="song-name" class="text-lg font-bold text-stone-800 dark:text-stone-200">Jazz BGM</p>
        <p id="song-index" class="text-xs text-stone-400 mt-1">1 / {songs.length}</p>
      </div>

      {/* 进度条 */}
      <div class="mb-5">
        <div id="progress-bar" class="mb-1.5 h-1.5 cursor-pointer overflow-hidden rounded-full bg-stone-200 dark:bg-stone-700">
          <div id="progress" class="h-full rounded-full bg-blue-500 transition-all duration-200" style="width: 0%"></div>
        </div>
        <div class="flex justify-between text-[11px] text-stone-400">
          <span id="current-time">0:00</span>
          <span id="total-time">0:00</span>
        </div>
      </div>

      {/* 播放控制 */}
      <div class="mb-5 flex items-center justify-center gap-6">
        <button id="prev-btn" class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-300 transition-colors" aria-label="上一首">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z" /></svg>
        </button>
        <button id="play-btn" class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-500 text-white shadow-md hover:bg-blue-600 active:scale-95 transition-all" aria-label="播放">
          <svg id="icon-play" class="h-5 w-5 ml-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
          <svg id="icon-pause" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <rect x="6" y="4" width="4" height="16" />
            <rect x="14" y="4" width="4" height="16" />
          </svg>
        </button>
        <button id="next-btn" class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-300 transition-colors" aria-label="下一首">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zm10-12v12h2V6z" /></svg>
        </button>
      </div>

      {/* 音量 */}
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 shrink-0 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
        </svg>
        <input id="volume" type="range" min="0" max="100" value="70" step="1" class="h-1 flex-1 cursor-pointer appearance-none rounded-full bg-stone-200 accent-blue-500 dark:bg-stone-700" />
        <svg class="h-4 w-4 shrink-0 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
        </svg>
      </div>
    </div>
  </div>

  {/* 歌单列表 */}
  <div class="mx-auto mt-8 max-w-lg">
    <h2 class="mb-4 font-serif text-xl font-bold text-stone-700 dark:text-stone-300">歌单</h2>
    <div class="space-y-2">
      {songs.map((song, i) => (
        <button
          class={`song-item flex w-full items-center gap-3 rounded-lg border border-stone-200/60 bg-white px-4 py-3 text-left transition-all hover:border-blue-400/30 hover:shadow-sm dark:border-stone-700/60 dark:bg-stone-900 ${i === 0 ? 'border-blue-400/30 shadow-sm' : ''}`}
          data-index={i}
        >
          <span class="song-num flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-stone-100 text-xs text-stone-500 dark:bg-stone-800 dark:text-stone-400">{i + 1}</span>
          <span class="song-label truncate text-sm font-medium text-stone-700 dark:text-stone-300">{song.name}</span>
        </button>
      ))}
    </div>
  </div>

  <audio id="audio" preload="none">
    {songs.map((song) => (
      <source src={song.src} type="audio/mpeg" />
    ))}
  </audio>

  <script define:vars={{ songList: songs.map(s => ({ name: s.name, src: s.src })) }}>
    (function () {
      var audio = document.getElementById('audio');
      var playBtn = document.getElementById('play-btn');
      var iconPlay = document.getElementById('icon-play');
      var iconPause = document.getElementById('icon-pause');
      var prevBtn = document.getElementById('prev-btn');
      var nextBtn = document.getElementById('next-btn');
      var progressBar = document.getElementById('progress');
      var progressWrap = document.getElementById('progress-bar');
      var currentTimeEl = document.getElementById('current-time');
      var totalTimeEl = document.getElementById('total-time');
      var volumeSlider = document.getElementById('volume');
      var songNameEl = document.getElementById('song-name');
      var songIndexEl = document.getElementById('song-index');
      var windowTitle = document.getElementById('window-title');
      var disc = document.getElementById('disc');
      var songItems = document.querySelectorAll('.song-item');

      var currentIndex = 0;
      var isPlaying = false;

      function formatTime(sec) {
        if (isNaN(sec)) return '0:00';
        var m = Math.floor(sec / 60);
        var s = Math.floor(sec % 60);
        return m + ':' + (s < 10 ? '0' : '') + s;
      }

      function updateUI() {
        songNameEl.textContent = songList[currentIndex].name;
        songIndexEl.textContent = (currentIndex + 1) + ' / ' + songList.length;
        windowTitle.textContent = songList[currentIndex].name;
        songItems.forEach(function (item, i) {
          if (i === currentIndex) {
            item.classList.add('border-blue-400/30', 'shadow-sm');
          } else {
            item.classList.remove('border-blue-400/30', 'shadow-sm');
          }
        });
      }

      function loadSong(index) {
        currentIndex = index;
        audio.src = songList[currentIndex].src;
        updateUI();
        if (isPlaying) {
          audio.play().catch(function () {});
        }
      }

      function togglePlay() {
        if (isPlaying) {
          audio.pause();
          isPlaying = false;
        } else {
          audio.play().catch(function () { isPlaying = false; updatePlayIcon(); });
          isPlaying = true;
        }
        updatePlayIcon();
      }

      function updatePlayIcon() {
        iconPlay.classList.toggle('hidden', isPlaying);
        iconPause.classList.toggle('hidden', !isPlaying);
      }

      playBtn.addEventListener('click', togglePlay);

      prevBtn.addEventListener('click', function () {
        loadSong((currentIndex - 1 + songList.length) % songList.length);
      });

      nextBtn.addEventListener('click', function () {
        loadSong((currentIndex + 1) % songList.length);
      });

      audio.addEventListener('play', function () { isPlaying = true; updatePlayIcon(); });
      audio.addEventListener('pause', function () { isPlaying = false; updatePlayIcon(); });

      audio.addEventListener('ended', function () {
        loadSong((currentIndex + 1) % songList.length);
      });

      audio.addEventListener('timeupdate', function () {
        if (audio.duration) {
          var pct = (audio.currentTime / audio.duration) * 100;
          progressBar.style.width = pct + '%';
          currentTimeEl.textContent = formatTime(audio.currentTime);
          totalTimeEl.textContent = formatTime(audio.duration);
        }
      });

      progressWrap.addEventListener('click', function (e) {
        if (audio.duration) {
          var rect = progressWrap.getBoundingClientRect();
          var pct = (e.clientX - rect.left) / rect.width;
          audio.currentTime = pct * audio.duration;
        }
      });

      volumeSlider.addEventListener('input', function () { audio.volume = volumeSlider.value / 100; });
      audio.volume = 0.7;

      songItems.forEach(function (item) {
        item.addEventListener('click', function () {
          var index = parseInt(item.getAttribute('data-index'));
          var wasPlaying = isPlaying;
          isPlaying = true;
          loadSong(index);
          if (!wasPlaying) audio.play().catch(function () { isPlaying = false; updatePlayIcon(); });
          updatePlayIcon();
        });
      });

      // 碟片旋转
      var rotation = 0;
      var animFrame = null;
      function animateDisc() {
        if (isPlaying) {
          rotation = (rotation + 0.6) % 360;
          disc.style.transform = 'rotate(' + rotation + 'deg)';
          animFrame = requestAnimationFrame(animateDisc);
        }
      }
      audio.addEventListener('play', function () { if (!animFrame) animateDisc(); });
      audio.addEventListener('pause', function () {
        if (animFrame) { cancelAnimationFrame(animFrame); animFrame = null; }
      });
    })();
  </script>
</Layout>
