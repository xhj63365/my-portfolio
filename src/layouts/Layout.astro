---
// 关键修复：在组件内引入全局样式，Astro 会在构建时注入 <head>
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Joexu 的个人作品集 —— 文字与光影' } = Astro.props;

// 当前路径，用于导航高亮
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/writing', label: '写作' },
  { href: '/photography', label: '摄影' },
  { href: '/about', label: '关于我' },
];
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    {/* 防闪烁：首帧渲染前根据本地偏好/系统偏好确定 dark 类 */}
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans">
    <nav
      class="sticky top-0 z-50 border-b border-stone-200/60 bg-stone-50/80 backdrop-blur-md dark:border-stone-800/60 dark:bg-stone-950/80"
    >
      <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
        <a href="/" class="font-serif text-xl font-bold tracking-tight hover:text-blue-600 transition-colors">
          文字与光影
        </a>
        <div class="flex items-center gap-5 text-sm font-medium sm:gap-6">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={`transition-colors hover:text-blue-600 ${
                  pathname.startsWith(item.href) ? 'text-blue-600' : ''
                }`}
              >
                {item.label}
              </a>
            ))
          }
          {/* 音乐分享按钮 */}
          <button
            id="music-share-btn"
            class="flex items-center gap-1 rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-600 transition-all hover:bg-blue-50 hover:text-blue-600 dark:bg-stone-800 dark:text-stone-400 dark:hover:bg-blue-900/30 dark:hover:text-blue-400"
            aria-label="打开音乐分享"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5">
              <path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6Z" />
            </svg>
            音乐
          </button>
          <button
            id="theme-toggle"
            class="rounded-full p-2 transition-colors hover:bg-stone-200 dark:hover:bg-stone-800"
            aria-label="切换明暗主题"
            aria-pressed="false"
          >
            <span class="dark:hidden">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
              </svg>
            </span>
            <span class="hidden dark:inline">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
              </svg>
            </span>
          </button>
        </div>
      </div>
    </nav>

    <main class="mx-auto max-w-4xl px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-stone-200/60 py-8 text-center text-sm text-stone-500 dark:border-stone-800/60">
      <p>&copy; {new Date().getFullYear()} Joexu · 文字与光影</p>
    </footer>

    <!-- ===== 音乐分享弹窗 (macOS 风格窗口) ===== -->
    <div id="music-modal-overlay" class="fixed inset-0 z-[10000] hidden items-center justify-center bg-black/30 backdrop-blur-sm">
      <div id="music-modal" class="relative w-[340px] max-w-[90vw] overflow-hidden rounded-xl border border-stone-200/80 bg-white shadow-2xl dark:border-stone-700/80 dark:bg-stone-900 transition-transform duration-300 scale-95 opacity-0">

        <!-- macOS 风格标题栏 -->
        <div class="flex items-center gap-2 border-b border-stone-200/60 px-4 py-3 dark:border-stone-700/60">
          <div class="flex items-center gap-1.5">
            <button id="music-modal-close" class="group relative h-3 w-3 rounded-full bg-[#ff5f57] transition-all hover:brightness-90" aria-label="关闭">
              <svg class="absolute inset-0 m-auto h-2 w-2 opacity-0 group-hover:opacity-100 transition-opacity" viewBox="0 0 8 8" fill="none" stroke="#4c0002" stroke-width="1.5" stroke-linecap="round">
                <path d="M1 1l6 6M7 1L1 7" />
              </svg>
            </button>
            <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
          </div>
          <span class="flex-1 text-center text-xs font-medium text-stone-500 dark:text-stone-400 select-none">音乐分享</span>
          <div class="w-[52px]"></div>
        </div>

        <!-- 内容区 -->
        <div class="p-5">
          <!-- 封面与歌曲信息 -->
          <div class="mb-5 flex items-center gap-4">
            <div id="music-disc-large" class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-stone-100 to-stone-200 dark:from-stone-700 dark:to-stone-800 shadow-inner">
              <svg class="h-8 w-8 text-stone-400 dark:text-stone-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <circle cx="12" cy="12" r="10"></circle>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <p id="music-modal-title" class="text-base font-bold text-stone-800 dark:text-stone-200 truncate">背景音乐</p>
              <p class="text-xs text-stone-500 dark:text-stone-400 mt-0.5">Joexu 的精选歌单</p>
            </div>
          </div>

          <!-- 进度条 -->
          <div class="mb-4">
            <div id="music-progress-bar" class="mb-1.5 h-1 cursor-pointer overflow-hidden rounded-full bg-stone-200 dark:bg-stone-700">
              <div id="music-progress" class="h-full rounded-full bg-blue-500 transition-all duration-200" style="width: 0%"></div>
            </div>
            <div class="flex justify-between text-[11px] text-stone-400">
              <span id="music-current-time">0:00</span>
              <span id="music-total-time">0:00</span>
            </div>
          </div>

          <!-- 播放控制 -->
          <div class="flex items-center justify-center gap-6">
            <button class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-300 transition-colors" disabled aria-label="上一首">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z" /></svg>
            </button>
            <button id="music-modal-play" class="flex h-11 w-11 items-center justify-center rounded-full bg-blue-500 text-white shadow-md hover:bg-blue-600 active:scale-95 transition-all" aria-label="播放">
              <svg id="modal-icon-play" class="h-5 w-5 ml-0.5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              <svg id="modal-icon-pause" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                <rect x="6" y="4" width="4" height="16" />
                <rect x="14" y="4" width="4" height="16" />
              </svg>
            </button>
            <button class="text-stone-400 hover:text-stone-600 dark:hover:text-stone-300 transition-colors" disabled aria-label="下一首">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zm10-12v12h2V6z" /></svg>
            </button>
          </div>

          <!-- 音量 -->
          <div class="mt-4 flex items-center gap-2">
            <svg class="h-3.5 w-3.5 shrink-0 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
            </svg>
            <input id="music-volume" type="range" min="0" max="100" value="70" step="1" class="h-1 flex-1 cursor-pointer appearance-none rounded-full bg-stone-200 accent-blue-500 dark:bg-stone-700" />
            <svg class="h-3.5 w-3.5 shrink-0 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- 音频元素 -->
    <audio id="music-audio" loop preload="none">
      <source src="/Jazzbgm.mp3" type="audio/mpeg">
    </audio>

    <script>
      // 主题切换
      const themeToggle = document.getElementById('theme-toggle');
      const htmlEl = document.documentElement;
      const syncPressed = () =>
        themeToggle?.setAttribute('aria-pressed', htmlEl.classList.contains('dark') ? 'true' : 'false');
      themeToggle?.addEventListener('click', () => {
        htmlEl.classList.toggle('dark');
        localStorage.setItem('theme', htmlEl.classList.contains('dark') ? 'dark' : 'light');
        syncPressed();
      });
      syncPressed();
    </script>

    <script>
      (function () {
        var audio = document.getElementById('music-audio');
        var openBtn = document.getElementById('music-share-btn');
        var overlay = document.getElementById('music-modal-overlay');
        var modal = document.getElementById('music-modal');
        var closeBtn = document.getElementById('music-modal-close');
        var playBtn = document.getElementById('music-modal-play');
        var iconPlay = document.getElementById('modal-icon-play');
        var iconPause = document.getElementById('modal-icon-pause');
        var progressBar = document.getElementById('music-progress');
        var progressWrap = document.getElementById('music-progress-bar');
        var currentTimeEl = document.getElementById('music-current-time');
        var totalTimeEl = document.getElementById('music-total-time');
        var volumeSlider = document.getElementById('music-volume');
        var disc = document.getElementById('music-disc-large');

        var isPlaying = false;
        var modalOpen = false;

        function formatTime(sec) {
          if (isNaN(sec)) return '0:00';
          var m = Math.floor(sec / 60);
          var s = Math.floor(sec % 60);
          return m + ':' + (s < 10 ? '0' : '') + s;
        }

        function openModal() {
          modalOpen = true;
          overlay.classList.remove('hidden');
          overlay.classList.add('flex');
          requestAnimationFrame(function () {
            modal.classList.remove('scale-95', 'opacity-0');
            modal.classList.add('scale-100', 'opacity-100');
          });
        }

        function closeModal() {
          modal.classList.remove('scale-100', 'opacity-100');
          modal.classList.add('scale-95', 'opacity-0');
          setTimeout(function () {
            overlay.classList.add('hidden');
            overlay.classList.remove('flex');
            modalOpen = false;
          }, 200);
        }

        openBtn.addEventListener('click', openModal);
        closeBtn.addEventListener('click', closeModal);

        overlay.addEventListener('click', function (e) {
          if (e.target === overlay) closeModal();
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && modalOpen) closeModal();
        });

        function updatePlayIcon() {
          iconPlay.classList.toggle('hidden', isPlaying);
          iconPause.classList.toggle('hidden', !isPlaying);
        }

        playBtn.addEventListener('click', function () {
          if (isPlaying) {
            audio.pause();
            isPlaying = false;
          } else {
            audio.play().catch(function () {
              isPlaying = false;
              updatePlayIcon();
            });
            isPlaying = true;
          }
          updatePlayIcon();
        });

        audio.addEventListener('play', function () { isPlaying = true; updatePlayIcon(); });
        audio.addEventListener('pause', function () { isPlaying = false; updatePlayIcon(); });

        audio.addEventListener('timeupdate', function () {
          if (audio.duration) {
            var pct = (audio.currentTime / audio.duration) * 100;
            progressBar.style.width = pct + '%';
            currentTimeEl.textContent = formatTime(audio.currentTime);
            totalTimeEl.textContent = formatTime(audio.duration);
          }
        });

        progressWrap.addEventListener('click', function (e) {
          if (audio.duration) {
            var rect = progressWrap.getBoundingClientRect();
            var pct = (e.clientX - rect.left) / rect.width;
            audio.currentTime = pct * audio.duration;
          }
        });

        volumeSlider.addEventListener('input', function () { audio.volume = volumeSlider.value / 100; });
        audio.volume = 0.7;

        var rotation = 0;
        var animFrame = null;
        function animateDisc() {
          if (isPlaying) {
            rotation = (rotation + 0.8) % 360;
            disc.style.transform = 'rotate(' + rotation + 'deg)';
            animFrame = requestAnimationFrame(animateDisc);
          }
        }
        audio.addEventListener('play', function () { if (!animFrame) animateDisc(); });
        audio.addEventListener('pause', function () {
          if (animFrame) { cancelAnimationFrame(animFrame); animFrame = null; }
        });
      })();
    </script>
  </body>
</html>
