---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="写作 - 文字与光影" description="所有写作作品">
  <h1 class="mb-2 font-serif text-4xl font-bold">写作</h1>
  <p class="mb-12 text-stone-600 dark:text-stone-400">
    把模糊的想法写清楚：随笔、阅读、生活与工具记录。共 {posts.length} 篇。
  </p>
  <div class="space-y-8">
    {
      posts.map((post) => (
        <article
          class="group border-l-2 border-stone-200 pl-6 transition-colors hover:border-blue-600 dark:border-stone-800"
        >
          <a href={`/writing/${post.id}/`} class="block">
            <time class="mb-1 block text-sm text-stone-500">{fmt(post.data.date)}</time>
            <h2 class="mb-2 text-2xl font-bold group-hover:text-blue-600">
              {post.data.title}
            </h2>
            {post.data.summary && (
              <p class="text-stone-600 dark:text-stone-400">{post.data.summary}</p>
            )}
            {post.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {post.data.tags.map((t) => (
                  <span
                    class="rounded-full bg-stone-100 px-3 py-0.5 text-xs text-stone-600 dark:bg-stone-800 dark:text-stone-400"
                  >
                    #{t}
                  </span>
                ))}
              </div>
            )}
          </a>
        </article>
      ))
    }
  </div>
</Layout>
