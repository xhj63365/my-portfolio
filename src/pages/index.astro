---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

const featuredWriting = (
  await getCollection('writing', ({ data }) => data.featured)
)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const featuredPhotography = (
  await getCollection('photography', ({ data }) => data.featured)
)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<Layout title="文字与光影 · Joexu 的作品集">
  <section class="mb-20 text-center">
    <h1
      class="mb-4 font-serif text-5xl font-bold tracking-tight md:text-6xl"
    >
      文字与光影
    </h1>
    <p class="mx-auto max-w-xl text-lg text-stone-600 dark:text-stone-400">
      一个记录我作品和成长的空间。<br />这里有我最值得留下的东西。
    </p>
  </section>

  <section class="mb-20">
    <div class="mb-8 flex items-end justify-between">
      <h2 class="font-serif text-3xl font-bold">写作</h2>
      <a href="/writing" class="text-sm font-medium text-blue-600 hover:text-blue-700">查看全部 →</a>
    </div>
    <div class="grid gap-6">
      {
        featuredWriting.map((post) => (
          <article
            class="group overflow-hidden rounded-xl border border-stone-200/60 bg-white shadow-sm transition-all hover:shadow-md dark:border-stone-700/60 dark:bg-stone-900"
          >
            {/* macOS 窗口标题栏 */}
            <div class="flex items-center gap-2 border-b border-stone-200/60 bg-stone-50/50 px-4 py-2.5 dark:border-stone-700/60 dark:bg-stone-800/50">
              <div class="flex items-center gap-1.5">
                <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
                <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
                <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
              </div>
              <span class="flex-1 text-center text-xs text-stone-400 dark:text-stone-500 truncate">{post.data.title}</span>
              <div class="w-[52px]"></div>
            </div>
            {/* 文章内容 */}
            <a href={`/writing/${post.id}/`} class="block p-6">
              <time class="mb-2 block text-xs text-stone-500">
                {fmt(post.data.date)}
              </time>
              <h3 class="mb-2 text-xl font-bold group-hover:text-blue-600">
                {post.data.title}
              </h3>
              {post.data.summary && (
                <p class="line-clamp-2 text-stone-600 dark:text-stone-400">
                  {post.data.summary}
                </p>
              )}
              {post.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {post.data.tags.map((t) => (
                    <span
                      class="rounded-full bg-stone-100 px-3 py-0.5 text-xs text-stone-600 dark:bg-stone-800 dark:text-stone-400"
                    >
                      {t}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </article>
        ))
      }
      {
        featuredWriting.length === 0 && (
          <p class="rounded-xl border border-dashed border-stone-300 px-6 py-8 text-center text-sm text-stone-500 dark:border-stone-700 dark:text-stone-400">
            暂无精选文章，可前往「写作」查看全部内容。
          </p>
        )
      }
    </div>
  </section>

  <section class="mb-20">
    <div class="mb-8 flex items-end justify-between">
      <h2 class="font-serif text-3xl font-bold">相册</h2>
      <a href="/photography" class="text-sm font-medium text-blue-600 hover:text-blue-700">查看全部 →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        featuredPhotography.map((p) => (
          <a
            href={`/photography/${p.id}/`}
            class="group overflow-hidden rounded-xl border border-stone-200/60 bg-white shadow-sm transition-all hover:shadow-md dark:border-stone-700/60 dark:bg-stone-900"
          >
            {/* macOS 窗口标题栏 */}
            <div class="flex items-center gap-2 border-b border-stone-200/60 bg-stone-50/50 px-3 py-2 dark:border-stone-700/60 dark:bg-stone-800/50">
              <div class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
              </div>
              <span class="flex-1 text-center text-[11px] text-stone-400 dark:text-stone-500 truncate">{p.data.title}</span>
              <div class="w-[40px]"></div>
            </div>
            {/* 封面图 */}
            <div class="relative aspect-[4/3] bg-stone-200 dark:bg-stone-800">
              <div class="absolute inset-0 flex items-center justify-center text-stone-400">
                <span class="text-4xl">📷</span>
              </div>
              <img
                src={p.data.coverImage}
                alt={p.data.title}
                loading="lazy"
                onerror="this.remove()"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity group-hover:opacity-100"
              />
              <div
                class="absolute bottom-0 left-0 right-0 translate-y-full p-4 text-white transition-transform group-hover:translate-y-0"
              >
                <h3 class="font-bold">{p.data.title}</h3>
                {p.data.location && <p class="text-sm opacity-85">{p.data.location}</p>}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
