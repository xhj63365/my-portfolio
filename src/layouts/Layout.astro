---
// 关键修复：在组件内引入全局样式，Astro 会在构建时注入 <head>
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Joexu 的个人作品集 —— 文字与光影' } = Astro.props;

// 当前路径，用于导航高亮
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/writing', label: '写作' },
  { href: '/photography', label: '摄影' },
  { href: '/about', label: '关于我' },
];
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    {/* 防闪烁：首帧渲染前根据本地偏好/系统偏好确定 dark 类 */}
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans">
    <nav
      class="sticky top-0 z-50 border-b border-stone-200/60 bg-stone-50/80 backdrop-blur-md dark:border-stone-800/60 dark:bg-stone-950/80"
    >
      <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
        <a href="/" class="font-serif text-xl font-bold tracking-tight hover:text-blue-600 transition-colors">
          文字与光影
        </a>
        <div class="flex items-center gap-5 text-sm font-medium sm:gap-6">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={`transition-colors hover:text-blue-600 ${
                  pathname.startsWith(item.href) ? 'text-blue-600' : ''
                }`}
              >
                {item.label}
              </a>
            ))
          }
          <button
            id="theme-toggle"
            class="rounded-full p-2 transition-colors hover:bg-stone-200 dark:hover:bg-stone-800"
            aria-label="切换明暗主题"
            aria-pressed="false"
          >
            <span class="dark:hidden">
              <!-- 月亮：亮色下显示 -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
              </svg>
            </span>
            <span class="hidden dark:inline">
              <!-- 太阳：暗色下显示 -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
              </svg>
            </span>
          </button>
        </div>
      </div>
    </nav>

    <main class="mx-auto max-w-4xl px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-stone-200/60 py-8 text-center text-sm text-stone-500 dark:border-stone-800/60">
      <p>&copy; {new Date().getFullYear()} Joexu · 文字与光影</p>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      const html = document.documentElement;
      const syncPressed = () =>
        toggle?.setAttribute('aria-pressed', html.classList.contains('dark') ? 'true' : 'false');
      toggle?.addEventListener('click', () => {
        html.classList.toggle('dark');
        localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        syncPressed();
      });
      syncPressed();
    </script>
  </body>
<div id="music-player" class="fixed bottom-6 right-6 z-[9999] flex flex-col items-end gap-2">
  <!-- 展开面板 -->
  <div id="music-panel"
    class="hidden w-64 rounded-xl border border-stone-200/60 bg-white/90 p-3 shadow-lg backdrop-blur-md
           dark:border-stone-800/60 dark:bg-stone-900/90 transition-all duration-300">
    <!-- 歌曲信息 -->
    <div class="mb-2 flex items-center gap-2">
      <div id="music-disc" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-stone-100 dark:bg-stone-800">
        <svg class="h-4 w-4 text-stone-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <circle cx="12" cy="12" r="10"></circle>
        </svg>
      </div>
      <div class="min-w-0 flex-1">
        <p id="music-title" class="truncate text-sm font-medium text-stone-800 dark:text-stone-200">背景音乐</p>
        <p id="music-time" class="text-xs text-stone-400">0:00 / 0:00</p>
      </div>
    </div>
    <!-- 进度条 -->
    <div class="mb-2 flex items-center gap-2">
      <input id="music-seek" type="range" min="0" max="100" value="0" step="0.1"
        class="h-1 flex-1 cursor-pointer appearance-none rounded-full bg-stone-200 accent-blue-500 dark:bg-stone-700
               [&::-webkit-slider-thumb]:h-3 [&::-webkit-slider-thumb]:w-3 [&::-webkit-slider-thumb]:appearance-none
               [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-blue-500">
    </div>
    <!-- 音量控制 -->
    <div class="flex items-center gap-2">
      <svg class="h-4 w-4 shrink-0 text-stone-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
        <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
      </svg>
      <input id="music-volume" type="range" min="0" max="100" value="70" step="1"
        class="h-1 flex-1 cursor-pointer appearance-none rounded-full bg-stone-200 accent-blue-500 dark:bg-stone-700
               [&::-webkit-slider-thumb]:h-3 [&::-webkit-slider-thumb]:w-3 [&::-webkit-slider-thumb]:appearance-none
               [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-blue-500">
    </div>
  </div>

  <!-- 主按钮 -->
  <button id="music-toggle"
    class="flex h-12 w-12 items-center justify-center rounded-full bg-white/90 shadow-lg backdrop-blur-md
           border border-stone-200/60 transition-all duration-300 hover:scale-110 hover:shadow-xl
           dark:bg-stone-900/90 dark:border-stone-800/60"
    aria-label="播放/暂停背景音乐">
    <!-- 播放图标 -->
    <svg id="icon-play" class="h-5 w-5 text-stone-600 dark:text-stone-300" xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24" fill="currentColor">
      <path d="M8 5v14l11-7z"></path>
    </svg>
    <!-- 暂停图标 -->
    <svg id="icon-pause" class="hidden h-5 w-5 text-blue-500" xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24" fill="currentColor">
      <rect x="6" y="4" width="4" height="16"></rect>
      <rect x="14" y="4" width="4" height="16"></rect>
    </svg>
  </button>
</div>

<!-- 音频元素 — 修改 src 为你的音频文件路径 -->
<audio id="music-audio" loop preload="none">
  <source src="/Jazzbgm.mp3" type="audio/mpeg">
  <!-- 如果需要其他格式，可以添加更多 source -->
  <!-- <source src="/bgm.ogg" type="audio/ogg"> -->
</audio>

<script>
(function () {
  const audio = document.getElementById('music-audio');
  const toggle = document.getElementById('music-toggle');
  const panel = document.getElementById('music-panel');
  const iconPlay = document.getElementById('icon-play');
  const iconPause = document.getElementById('icon-pause');
  const seek = document.getElementById('music-seek');
  const volume = document.getElementById('music-volume');
  const timeEl = document.getElementById('music-time');
  const disc = document.getElementById('music-disc');

  let isPlaying = false;
  let panelVisible = false;

  // 格式化时间 mm:ss
  function formatTime(sec) {
    if (isNaN(sec)) return '0:00';
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return m + ':' + (s < 10 ? '0' : '') + s;
  }

  // 切换面板显隐
  function togglePanel() {
    panelVisible = !panelVisible;
    panel.classList.toggle('hidden', !panelVisible);
  }

  // 更新播放/暂停图标
  function updateIcon() {
    iconPlay.classList.toggle('hidden', isPlaying);
    iconPause.classList.toggle('hidden', !isPlaying);
  }

  // 点击主按钮
  toggle.addEventListener('click', function () {
    if (!panelVisible) {
      togglePanel();
    }
    if (isPlaying) {
      audio.pause();
      isPlaying = false;
    } else {
      audio.play().catch(function () {
        isPlaying = false;
        updateIcon();
      });
      isPlaying = true;
    }
    updateIcon();
  });

  // 音频播放事件
  audio.addEventListener('play', function () {
    isPlaying = true;
    updateIcon();
  });

  audio.addEventListener('pause', function () {
    isPlaying = false;
    updateIcon();
  });

  // 时间更新
  audio.addEventListener('timeupdate', function () {
    if (audio.duration) {
      seek.value = (audio.currentTime / audio.duration) * 100;
      timeEl.textContent = formatTime(audio.currentTime) + ' / ' + formatTime(audio.duration);
    }
  });

  // 拖动进度条
  seek.addEventListener('input', function () {
    if (audio.duration) {
      audio.currentTime = (seek.value / 100) * audio.duration;
    }
  });

  // 音量控制
  volume.addEventListener('input', function () {
    audio.volume = volume.value / 100;
  });

  // 初始化音量
  audio.volume = 0.7;

  // 点击播放器外部关闭面板
  document.addEventListener('click', function (e) {
    const player = document.getElementById('music-player');
    if (panelVisible && !player.contains(e.target)) {
      togglePanel();
    }
  });

  // 播放时碟片旋转动画
  let rotation = 0;
  let animFrame = null;
  function animateDisc() {
    if (isPlaying) {
      rotation = (rotation + 1) % 360;
      disc.style.transform = 'rotate(' + rotation + 'deg)';
      animFrame = requestAnimationFrame(animateDisc);
    }
  }
  audio.addEventListener('play', function () {
    if (!animFrame) animateDisc();
  });
  audio.addEventListener('pause', function () {
    if (animFrame) {
      cancelAnimationFrame(animFrame);
      animFrame = null;
    }
  });
})();
</script>
</html>
