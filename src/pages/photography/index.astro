---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });

const photos = (await getCollection('photography')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="摄影 - 文字与光影" description="所有摄影作品">
  <h1 class="mb-2 font-serif text-4xl font-bold">摄影</h1>
  <p class="mb-12 text-stone-600 dark:text-stone-400">
    留住某个瞬间的光：风光、街头与日常。共 {photos.length} 组。
  </p>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      photos.map((p) => (
        <a
          href={`/photography/${p.id}/`}
          class="group flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-all hover:border-blue-400/30 hover:shadow-md dark:border-stone-800 dark:bg-stone-900"
        >
          <div class="relative aspect-[4/3] bg-stone-200 dark:bg-stone-800">
            <div
              class="absolute inset-0 flex items-center justify-center text-stone-400"
            >
              <span class="text-4xl">📷</span>
            </div>
            <img
              src={p.data.coverImage}
              alt={p.data.title}
              loading="lazy"
              onerror="this.remove()"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <div class="p-4">
            <h2 class="font-bold group-hover:text-blue-600">{p.data.title}</h2>
            <div class="mt-1 flex flex-wrap items-center gap-3 text-xs text-stone-500">
              {p.data.location && <span>📍 {p.data.location}</span>}
              <time>{fmt(p.data.date)}</time>
            </div>
            {p.data.tags.length > 0 && (
              <div class="mt-2 flex flex-wrap gap-2">
                {p.data.tags.map((t) => (
                  <span
                    class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-600 dark:bg-stone-800 dark:text-stone-400"
                  >
                    #{t}
                  </span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))
    }
  </div>
</Layout>
